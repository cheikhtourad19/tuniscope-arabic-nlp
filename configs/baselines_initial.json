{
  "version": "baseline-initial-v1",
  "seed": 42,
  "corpora": ["tsac", "madar"],
  "labels": {"tsac": ["NEG", "POS"], "madar": ["MSA", "TN", "EG"]},
  "variants": ["raw-v0", "norm-nfc-space-v1"],
  "tfidf": {
    "analyzer": "char", "ngram_range": [3, 5], "lowercase": false,
    "min_df": 2, "sublinear_tf": true, "norm": "l2", "dtype": "float64"
  },
  "classifier": {"C": 1.0, "class_weight": null, "max_iter": 1000, "solver": "lbfgs"},
  "threads": 1,
  "smoke_rows_per_partition": 100
}
