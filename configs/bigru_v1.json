{
  "version": "bigru-word-raw-v2-v1",
  "manifest_version": "v2",
  "corpora": ["tsac", "madar"],
  "labels": {"tsac": ["NEG", "POS"], "madar": ["MSA", "TN", "EG"]},
  "variant": "raw-v0",
  "tokenizer": "unicode-word-symbol-v1",
  "max_vocabulary": 20000,
  "min_frequency": 2,
  "max_length": 128,
  "embedding_dim": 64,
  "hidden_dim": 64,
  "layers": 1,
  "pooling": "masked-mean",
  "dropout": 0.2,
  "batch_size": 64,
  "max_epochs": 12,
  "patience": 3,
  "learning_rate": 0.001,
  "weight_decay": 0.0,
  "gradient_clip": 1.0,
  "seeds": [13, 42, 2026],
  "device": "cpu",
  "cpu_threads": 2,
  "smoke_rows_per_partition": 100,
  "smoke_epochs": 2,
  "smoke_seed": 42,
  "selection_metric": "validation_macro_f1",
  "tie_break": "earliest_epoch"
}
