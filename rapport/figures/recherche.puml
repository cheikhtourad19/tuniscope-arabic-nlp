@startuml
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam ArrowColor #595959
skinparam shadowing false
skinparam rectangle {
 BorderColor #4C4C4C
 FontColor #171717
 RoundCorner 10
}
rectangle "Question\nLangue choisie" as query #F5F5F5
rectangle "Fiches sourcées\nFrançais ou arabe" as cards #F5F5F5
rectangle "BM25 ou E5\nClassement des fiches" as ranking #F1F1F1
rectangle "Règle de décision\nAccepter ou rejeter" as threshold #F1F1F1
rectangle "Passage exact\nFiche et références" as extract #E9E9E9
rectangle "Abstention\nSources insuffisantes" as abstain #FFFFFF
query --> ranking
cards --> ranking
ranking --> threshold
threshold --> extract
threshold --> abstain
@enduml
